        "filter": { "name": "mingji-daily", "kind": "bin" }
      },
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "dev: vite 后台 (调试用)",
      "postDebugTask": "stop: vite (端口 1420)"
    }
  ]
}
